{#
  SECTION: overview — scroll-pinned image swap with numbered list (home "design documentation")
  data: { eyebrow, title, text, items:[{ title, text, image }], button }
#}
{% import "partials/macros.njk" as ui %}
<section class="{{ ui.wrapperClass(section) }} rt-overview-v6" id="{{ _id }}" data-pin>
  <div class="rt-container rt-overview-grid">
    <div class="rt-overview-copy">
      {{ ui.sectionHead(s, "left", section.theme == "dark") }}
      <ol class="rt-overview-list">
        {% for it in s.items %}
          <li class="rt-overview-item{% if loop.first %} is-active{% endif %}" data-overview-item="{{ loop.index0 }}">
            <span class="rt-overview-num">{{ loop.index | pad }}</span>
            <div><h4>{{ it.title }}</h4><p>{{ it.text }}</p></div>
          </li>
        {% endfor %}
      </ol>
      {% if s.button %}<div data-reveal>{{ ui.button(s.button) }}</div>{% endif %}
    </div>
    <div class="rt-overview-media">
      {% for it in s.items %}<img class="rt-overview-img{% if loop.first %} is-active{% endif %}" data-overview-img="{{ loop.index0 }}" src="{{ it.image | media }}" alt="{{ it.alt or it.title }}" loading="lazy">{% endfor %}
    </div>
  </div>
</section>
