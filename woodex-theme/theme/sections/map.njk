{#
  SECTION: map — embedded map + studio card (uses site.contact.mapEmbed)
  data: { title, text, embed?, height }
#}
{% set c = site.contact %}
<section class="{{ 'rt-section rt-theme-' ~ (section.theme or 'light') }} rt-space-{{ section.spacing or 'none' }} rt-map" id="{{ _id }}">
  <div class="rt-map-frame" style="--map-h:{{ s.height or '34rem' }}">
    <iframe src="{{ s.embed or c.mapEmbed }}" title="Map to {{ site.brand.name }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    <div class="rt-map-card" data-reveal>
      <h5>{{ s.title or 'Visit the studio' }}</h5>
      <p>{% for l in c.addressLines %}{{ l }}<br>{% endfor %}{{ c.hours }}</p>
      <a class="rt-service-button" href="{{ c.mapLink }}" target="_blank" rel="noopener"><span>Open in maps</span><svg aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
    </div>
  </div>
</section>
