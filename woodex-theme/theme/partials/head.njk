{% set _url = site.seo.siteUrl ~ page.url %}
{% set _og = ogImage | media %}
{% if not (_og.startsWith("http")) %}{% set _og = site.seo.siteUrl ~ _og %}{% endif %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ _url }}">
{% if noindex %}<meta name="robots" content="noindex,follow">{% endif %}

<meta property="og:type" content="{{ 'article' if ogType == 'article' else 'website' }}">
<meta property="og:site_name" content="{{ site.brand.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ _url }}">
<meta property="og:image" content="{{ _og }}">
<meta property="og:locale" content="{{ site.seo.locale }}">
<meta name="twitter:card" content="summary_large_image">
{% if site.seo.twitter %}<meta name="twitter:site" content="{{ site.seo.twitter }}">{% endif %}

<meta name="theme-color" content="{{ site.theme.colors.navy }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

{# Performance: preload the first hero image on pages that open with a hero (LCP element) #}
{% set _lcp = "" %}
{% if sections and sections.length %}
  {% set _first = sections[0] %}
  {% if _first.type == "hero-slider" and _first.data.slides and _first.data.slides.length %}{% set _lcp = _first.data.slides[0].image %}
  {% elif _first.type in ["page-hero", "hero-static", "hero-split"] and _first.data.image %}{% set _lcp = _first.data.image %}{% endif %}
{% elif (imageWide or image) and layout != "post.njk" %}{% set _lcp = imageWide or image %}{% endif %}
{% if _lcp %}<link rel="preload" as="image" href="{{ _lcp | media }}" fetchpriority="high">{% endif %}

<link rel="stylesheet" href="/assets/css/theme.css">
{# Web fonts load non-blocking (swap in when ready); the <noscript> keeps them for no-JS visitors #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ site.theme.fonts.googleFonts }}&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ site.theme.fonts.googleFonts }}&display=swap"></noscript>

{# Brand tokens from site.json override the CSS defaults #}
<style id="brand-tokens">
  :root{
    --c-navy:{{ site.theme.colors.navy }};
    --c-jet:{{ site.theme.colors.jet }};
    --c-charcoal:{{ site.theme.colors.charcoal }};
    --c-ghost:{{ site.theme.colors.ghost }};
    --c-light-beige:{{ site.theme.colors.beige }};
    --c-light-gray:{{ site.theme.colors.lightGray }};
    --c-silver:{{ site.theme.colors.silver }};
    --c-accent:{{ site.theme.colors.accent }};
    --font-heading:"{{ site.theme.fonts.heading }}", "Inter", system-ui, sans-serif;
    --font-body:"{{ site.theme.fonts.body }}", system-ui, sans-serif;
    --radius-large:{{ site.theme.radius }};
  }
</style>
<script>document.documentElement.classList.replace('no-js','js');window.WX={forms:{provider:"{{ site.forms.provider }}",endpoint:"{{ site.forms.endpoint }}",accessKey:"{{ site.forms.accessKey }}",successMessage:{{ site.forms.successMessage | dump | safe }},newsletterSuccess:{{ site.forms.newsletterSuccess | dump | safe }},fallbackEmail:"{{ site.contact.email }}"}};</script>

{# Structured data: organisation / local business #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{{ site.seo.business.type }}",
  "name": "{{ site.brand.name }}",
  "url": "{{ site.seo.siteUrl }}",
  "image": "{{ _og }}",
  "email": "{{ site.contact.email }}",
  "telephone": "{{ site.contact.phone }}",
  "priceRange": "{{ site.seo.business.priceRange }}",
  "address": { "@type": "PostalAddress", "streetAddress": "{{ site.contact.addressLines[0] }}", "addressLocality": "{{ site.contact.addressLines[1] }}" },
  "geo": { "@type": "GeoCoordinates", "latitude": {{ site.seo.business.geo.lat }}, "longitude": {{ site.seo.business.geo.lng }} },
  {#- only list social profiles that point at a real account (not bare "https://instagram.com/" placeholders) -#}
  {%- set _same = [] -%}
  {%- for s in site.social -%}{%- if s.url and (s.url | replace("https://", "") | replace("http://", "") | replace("www.", "")).split("/").length > 1 and (s.url | replace("https://", "") | replace("http://", "") | replace("www.", "")).split("/")[1] -%}{%- set _same = (_same.push(s.url), _same) -%}{%- endif -%}{%- endfor -%}
  "sameAs": {{ _same | dump | safe }}
}
</script>
{% if headExtra %}{{ headExtra | safe }}{% endif %}
